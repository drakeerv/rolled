{
    "python.defaultInterpreterPath": "${workspaceFolder}/ingestion/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        },
        "editor.rulers": [
            100
        ]
    },
    "ruff.nativeServer": "on",
    "ruff.importStrategy": "fromEnvironment",
    "ruff.configuration": "${workspaceFolder}/ingestion/pyproject.toml",
    "mypy-type-checker.importStrategy": "fromEnvironment",
    "mypy-type-checker.cwd": "${workspaceFolder}/ingestion",
    "mypy-type-checker.reportingScope": "custom",
    "mypy-type-checker.preferDaemon": true
}